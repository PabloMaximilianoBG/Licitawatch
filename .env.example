# ============================================================
# LicitaWatch — plantilla de variables de entorno (SIN secretos)
# ============================================================
# 1. Copia este archivo como ".env" en la raíz del proyecto.
# 2. Completa los valores marcados con <...>.
# 3. ".env" está en .gitignore: nunca se sube a Git.
# Cada microservicio Java lo lee al arrancar (spring.config.import=../.env)
# y el frontend lee solo las variables VITE_* (vite.config.ts -> envDir: '..').
# ============================================================

# ---------- PostgreSQL (instalación local, un motor, 4 bases) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<tu_password_de_postgres>
DB_USUARIOS_NAME=licitawatch_usuarios
DB_LICITACIONES_NAME=licitawatch_licitaciones
DB_VENTAS_NAME=licitawatch_ventas
DB_NOTIFICACIONES_NAME=licitawatch_notificaciones

# ---------- JWT (el MISMO secreto en Usuarios, Gateway y demás APIs) ----------
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=<secreto_aleatorio_de_al_menos_32_caracteres>
# Minutos de vigencia del token
JWT_EXPIRATION=60

# ---------- Comunicación interna entre microservicios (/internal/**) ----------
INTERNAL_API_KEY=<otro_secreto_aleatorio_largo>

# ---------- Webpay Plus (Transbank) ----------
# Credenciales PÚBLICAS de integración de Transbank (ambiente de pruebas):
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# SANDBOX: ambiente de integración de Transbank (pruebas, sin cobros reales). Valores: SANDBOX | INTEGRATION | PRODUCTION
WEBPAY_ENVIRONMENT=SANDBOX
# Webpay vuelve al Gateway, que enruta a API Ventas; ésta confirma y redirige al frontend
WEBPAY_RETURN_URL=http://localhost:8080/api/pagos/webpay/retorno

# ---------- Groq (LicitAsist) ----------
GROQ_API_KEY=<tu_api_key_de_groq>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# ---------- SMTP ----------
# Ejemplo Gmail: requiere "contraseña de aplicación" (no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<tu_correo>
SMTP_PASSWORD=<tu_contraseña_de_aplicación>
SMTP_FROM=<tu_correo>
SMTP_STARTTLS=true

# ---------- Administrador inicial (API Usuarios lo crea al arrancar si no existe) ----------
ADMIN_EMAIL=admin@licitawatch.local
ADMIN_PASSWORD=<contraseña_segura_del_admin>
ADMIN_NAME=Administrador
# Caracteres no ASCII: usar escape Unicode (Spring lee .env como ISO-8859-1)
ADMIN_AREA=Administración

# ---------- Rate limiting (Gateway) ----------
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_ASISTENTE_PER_MINUTE=20

# ---------- URLs ----------
FRONTEND_URL=http://localhost:5173
USUARIOS_URL=http://localhost:8081
LICITACIONES_URL=http://localhost:8082
VENTAS_URL=http://localhost:8083
NOTIFICACIONES_URL=http://localhost:8084
ASISTENTE_URL=http://localhost:8085

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080
